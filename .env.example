# Copy to .env.local for local development, and set the same variables in
# Vercel (Project → Settings → Environment Variables) for deployments.
# NEXT_PUBLIC_ variables are built into the browser bundle: redeploy after
# changing one.

# Contact page inquiry form — the Google Apps Script web app URL, ending in
# /exec. Setup: integrations/google-apps-script/contact-form/README.md
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Optional. Canonical origin for metadata, Open Graph and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
